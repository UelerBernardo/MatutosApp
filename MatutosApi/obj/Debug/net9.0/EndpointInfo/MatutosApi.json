{
  "openapi": "3.0.4",
  "info": {
    "title": "Matutos-API",
    "version": "v1"
  },
  "paths": {
    "/usuario/telefone": {
      "post": {
        "tags": [
          "Usuario"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Telefone"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Telefone"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Telefone"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/usuario/cadastrar": {
      "post": {
        "tags": [
          "Usuario"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioCadastro"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioCadastro"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioCadastro"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/usuario/login": {
      "post": {
        "tags": [
          "Usuario"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioLogin"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioLogin"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Telefone": {
        "type": "object",
        "properties": {
          "codigo_Telefone": {
            "type": "integer",
            "format": "int32"
          },
          "numero_Telefone": {
            "type": "string",
            "nullable": true
          },
          "ddd": {
            "type": "string",
            "nullable": true
          },
          "principal": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UsuarioCadastro": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "senha": {
            "type": "string",
            "nullable": true
          },
          "tipoSelecionado": {
            "$ref": "#/components/schemas/UsuarioTipo"
          }
        },
        "additionalProperties": false
      },
      "UsuarioLogin": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "senha": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UsuarioTipo": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "JWT Authorization header usando o esquema Bearer. Exemplo: \"Authorization: Bearer {token}\"",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}