<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MatutosApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MatutosApp"
    xmlns:views="clr-namespace:MatutosApp.Views"
    Title="MatutosApp">

    <ShellContent
        x:Name="ItemLogin"
        Title="Login"
        Route="LoginView"
        FlyoutItem.IsVisible="False"
        ContentTemplate="{DataTemplate views:LoginView}" />

    <FlyoutItem Title="Início" Icon="home_icon.png">
        <ShellContent 
            Route="PrincipalView" 
            ContentTemplate="{DataTemplate views:PrincipalView}" />
    </FlyoutItem>

</Shell>