<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.ServicoCadastroView"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False"
             x:Name="PaginaCadastroServico">

    <ContentPage.Resources>

        <!-- ESTILO 1: Escuro com destaque em Vermelho/Vinho (Ideal para cancelar ou ações secundárias) -->
        <Style x:Key="BotaoVermelhoStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#a15650" />
            <Setter Property="BorderColor" Value="#a15650" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HeightRequest" Value="55" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#a15650" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- ESTILO 2: Tons de Cinza (Ideal para botões de ação principal) -->
        <Style x:Key="BotaoCinzaStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E0E0E0" />
            <Setter Property="TextColor" Value="#121212" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HeightRequest" Value="55" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#888888" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- ESTILO 3: Cinza escuro para itens secundários compactos (Selecionar Foto) -->
        <Style x:Key="BotaoSecundarioStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#2A2A2A" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="BorderColor" Value="#555555" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="45" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#444444" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="20,40,20,40">

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,0,0,10">
                <Image Source="mais.png" HeightRequest="50" WidthRequest="50"/>
                <Label Text="{Binding TituloPagina}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center" />
                <Label Text="Preencha os Dados"
                       FontSize="14"
                       TextColor="#AAAAAA"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#333333" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="20">

                <VerticalStackLayout Spacing="20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Descrição do Serviço" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                            <Entry Text="{Binding Descricao}" 
                                   Placeholder="Ex: Corte Degradê" 
                                   TextColor="#FFFFFF" 
                                   PlaceholderColor="#888888" 
                                   MaxLength="250"
                                   BackgroundColor="Transparent" 
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Preço (R$)" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                            <Entry Text="{Binding Preco}" 
                                   Keyboard="Numeric" 
                                   Placeholder="Ex: 45.00" 
                                   TextColor="#FFFFFF" 
                                   PlaceholderColor="#888888" 
                                   BackgroundColor="Transparent" 
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="Duração (Texto)" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                                <Entry Text="{Binding Duracao}" 
                                       Placeholder="Ex: 45 min" 
                                       TextColor="#FFFFFF"
                                       MaxLength="250"
                                       PlaceholderColor="#888888" 
                                       BackgroundColor="Transparent" 
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Tempo (Minutos)" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                                <Entry Text="{Binding Tempo_servico}" 
                                       Keyboard="Numeric" 
                                       Placeholder="Ex: 45" 
                                       TextColor="#FFFFFF"
                                       MaxLength="11"
                                       PlaceholderColor="#888888" 
                                       BackgroundColor="Transparent" 
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Serviço Ativo?" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" />
                            <Label Text="Disponível para agendamentos" TextColor="#888888" FontSize="12" />
                        </VerticalStackLayout>

                        <Switch Grid.Column="1" 
                                IsToggled="{Binding Ativo}" 
                                OnColor="#4CAF50" 
                                ThumbColor="#FFFFFF" 
                                VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#1E1E1E" 
                   Stroke="#333333" 
                   StrokeThickness="1" 
                   StrokeShape="RoundRectangle 20" 
                   Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Imagens do Serviço" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding ImagensNovasBase64.Count, StringFormat='{0}/3'}" TextColor="#AAAAAA" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding ImagensNovasBase64}" HeightRequest="120" HorizontalOptions="Center">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5" Margin="0,20">
                                <Image Source="imagemservico.png" HorizontalOptions="Center" WidthRequest="80" HeightRequest="80"/>
                                <Label Text="Nenhuma imagem." TextColor="#666666" FontSize="14" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid WidthRequest="100" HeightRequest="100">

                                    <Border StrokeShape="RoundRectangle 10" Stroke="#333333" StrokeThickness="1" BackgroundColor="#2A2A2A">
                                        <Image Source="{Binding FonteImagem}" Aspect="AspectFill" />
                                    </Border>

                                    <ImageButton 
                                        Source="xvermelho.png"
                                        WidthRequest="2" 
                                        HeightRequest="1"
                                        CornerRadius="15" 
                                        Padding="0"
                                        HorizontalOptions="End" 
                                        VerticalOptions="Start" 
                                        Margin="3"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoverImagemCommand}"
                                        CommandParameter="{Binding .}" />

                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Botão Selecionar Foto com Estilo Secundário -->
                    <Button Text="Selecionar Foto"
                            Command="{Binding SelecionarImagemServicoCommand}"
                            Style="{StaticResource BotaoSecundarioStyle}"
                            Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="15" Margin="0,10,0,0">

                <!-- Botão Principal de Ação (Cadastrar/Alterar) com Estilo Cinza -->
                <Button Text="{Binding NomeBotaoAcao}"
                        Command="{Binding CadastrarOuAlterarCommand}"
                        Style="{StaticResource BotaoCinzaStyle}" />

                <!-- Botão Cancelar com Estilo Vermelho -->
                <Button Text="Cancelar"
                        Command="{Binding VoltarTela}"
                        Style="{StaticResource BotaoVermelhoStyle}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>