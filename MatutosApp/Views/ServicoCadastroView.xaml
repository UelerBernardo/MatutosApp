<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.ServicoCadastroView"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="20,40,20,40">

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,0,0,10">
                <Image Source="mais.png" HeightRequest="50" WidthRequest="50"/>
                <Label Text="Novo Serviço"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center" />
                <Label Text="Preencha os dados para cadastrar"
                       FontSize="14"
                       TextColor="#AAAAAA"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#333333" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="20">

                <VerticalStackLayout Spacing="20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Descrição do Serviço" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                            <Entry Text="{Binding Descricao}" 
                                   Placeholder="Ex: Corte Degradê" 
                                   TextColor="#FFFFFF" 
                                   PlaceholderColor="#888888" 
                                   BackgroundColor="Transparent" 
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Preço (R$)" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                            <Entry Text="{Binding Preco}" 
                                   Keyboard="Numeric" 
                                   Placeholder="Ex: 45.00" 
                                   TextColor="#FFFFFF" 
                                   PlaceholderColor="#888888" 
                                   BackgroundColor="Transparent" 
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="Duração (Texto)" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                                <Entry Text="{Binding Duracao}" 
                                       Placeholder="Ex: 45 min" 
                                       TextColor="#FFFFFF" 
                                       PlaceholderColor="#888888" 
                                       BackgroundColor="Transparent" 
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Tempo (Minutos)" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                                <Entry Text="{Binding Tempo_servico}" 
                                       Keyboard="Numeric" 
                                       Placeholder="Ex: 45" 
                                       TextColor="#FFFFFF" 
                                       PlaceholderColor="#888888" 
                                       BackgroundColor="Transparent" 
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Serviço Ativo?" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" />
                            <Label Text="Disponível para agendamentos" TextColor="#888888" FontSize="12" />
                        </VerticalStackLayout>

                        <Switch Grid.Column="1" 
                                IsToggled="{Binding Ativo}" 
                                OnColor="#4CAF50" 
                                ThumbColor="#FFFFFF" 
                                VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#1E1E1E" 
                 Stroke="#333333" 
                 StrokeThickness="1" 
                 StrokeShape="RoundRectangle 20" 
                 Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Imagens do Serviço" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding ImagensNovasBase64.Count, StringFormat='{0}/3'}" TextColor="#AAAAAA" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding ImagensNovasBase64}" HeightRequest="120" HorizontalOptions="Center">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5" Margin="0,20">
                                <Label Text="🖼️" FontSize="30" HorizontalOptions="Center" />
                                <Label Text="Nenhuma imagem." TextColor="#666666" FontSize="14" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 10" Stroke="#333333" StrokeThickness="1" BackgroundColor="#2A2A2A" WidthRequest="100" HeightRequest="100">
                                    <Image Source="{Binding FonteImagem}" Aspect="AspectFill" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="📷 Selecionar Foto"
                             Command="{Binding SelecionarImagemServicoCommand}"
                             BackgroundColor="#2A2A2A"
                             TextColor="#FFFFFF"
                             BorderColor="#555555"
                             BorderWidth="1"
                             FontAttributes="Bold"
                             CornerRadius="10"
                             HeightRequest="45"
                             Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="15" Margin="0,10,0,0">
                <Button Text="Cadastrar Serviço"
                        Command="{Binding CadastrarServicoCommand}"
                        BackgroundColor="#E0E0E0"
                        TextColor="#121212"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="55" />

                <Button Text="Cancelar"
                        Command="{Binding VoltarTela}"
                        BackgroundColor="Transparent"
                        TextColor="#AAAAAA"
                        BorderColor="#333333"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="55" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>