<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.ServicoCadastroView">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="20,40,20,40">

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,0,0,10">
                <!--<Label Text="➕" FontSize="40" HorizontalOptions="Center" />-->
                <Image Source="mais.png" HeightRequest="50" WidthRequest="50"/>
                <Label Text="Novo Serviço"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center" />
                <Label Text="Preencha os dados para cadastrar"
                       FontSize="14"
                       TextColor="#AAAAAA"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#333333" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="20">

                <VerticalStackLayout Spacing="20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Descrição do Serviço" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                            <Entry Text="{Binding Descricao}" 
                                   Placeholder="Ex: Corte Degradê" 
                                   TextColor="#FFFFFF" 
                                   PlaceholderColor="#888888" 
                                   BackgroundColor="Transparent" 
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Preço (R$)" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                            <Entry Text="{Binding Preco}" 
                                   Keyboard="Numeric" 
                                   Placeholder="Ex: 45.00" 
                                   TextColor="#FFFFFF" 
                                   PlaceholderColor="#888888" 
                                   BackgroundColor="Transparent" 
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="Duração (Texto)" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                                <Entry Text="{Binding Duracao}" 
                                       Placeholder="Ex: 45 min" 
                                       TextColor="#FFFFFF" 
                                       PlaceholderColor="#888888" 
                                       BackgroundColor="Transparent" 
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Tempo (Minutos)" TextColor="#CCCCCC" FontAttributes="Bold" FontSize="14" />
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                                <Entry Text="{Binding Tempo_servico}" 
                                       Keyboard="Numeric" 
                                       Placeholder="Ex: 45" 
                                       TextColor="#FFFFFF" 
                                       PlaceholderColor="#888888" 
                                       BackgroundColor="Transparent" 
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Serviço Ativo?" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" />
                            <Label Text="Disponível para agendamentos" TextColor="#888888" FontSize="12" />
                        </VerticalStackLayout>

                        <Switch Grid.Column="1" 
                                IsToggled="{Binding Ativo}" 
                                OnColor="#E0E0E0" 
                                ThumbColor="#FFFFFF" 
                                VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#1E1E1E" 
                 Stroke="#333333" 
                 StrokeThickness="1" 
                 StrokeShape="RoundRectangle 20" 
                 Padding="20">
                
            </Border>

            <VerticalStackLayout Spacing="15" Margin="0,10,0,0">
                <Button Text="Cadastrar Serviço"
                        Command="{Binding CadastrarServicoCommand}"
                        BackgroundColor="#E0E0E0"
                        TextColor="#121212"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="55" />

                <Button Text="Cancelar"
                        Command="{Binding VoltarTela}"
                        BackgroundColor="Transparent"
                        TextColor="#AAAAAA"
                        BorderColor="#333333"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="55" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>