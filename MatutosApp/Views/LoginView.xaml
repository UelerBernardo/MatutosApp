<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.LoginView"
             xmlns:views="clr-namespace:MatutosApp.Views"
             Title="LoginView">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">
            <Label Text="BEM-VINDO A BARBERIA MATUTOS"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#2B0B3F"/>

            <Label Text="Acesse sua conta para agendar seu horário."
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0, -15, 0, 20"/>

            <VerticalStackLayout Spacing="5">
                <Label Text="E-mail" FontSize="14" FontAttributes="Bold" />
                <Entry Placeholder="exemplo@email.com"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Senha" FontSize="14" FontAttributes="Bold" />
                <Entry Placeholder="******"
                       Text="{Binding Senha}"
                       IsPassword="True" 
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <Button Text="ENTRAR"
                    Command="{Binding LogarCommand}"
                    BackgroundColor="#2B0B3F"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="55"
                    Margin="0, 10, 0, 0"/>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="Novo por aqui?" VerticalOptions="Center"/>
                <Label Text="Cadastre-se" 
                       TextColor="#2B0B3F"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirTela}"
                                              CommandParameter="{x:Type TypeName=views:UsuarioCadastroView}"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>