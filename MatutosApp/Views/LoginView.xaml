<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.LoginView"
             xmlns:views="clr-namespace:MatutosApp.Views"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!-- ESTILO: Tons de Cinza (Ação Principal) -->
        <Style x:Key="BotaoCinzaStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E0E0E0" />
            <Setter Property="TextColor" Value="#121212" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HeightRequest" Value="55" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#888888" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

    </ContentPage.Resources>

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Spacing="25" Padding="30">

            <Border Stroke="#333333" 
                    StrokeThickness="2" 
                    WidthRequest="150" 
                    HeightRequest="150" 
                    BackgroundColor="#1E1E1E"
                    HorizontalOptions="Center"
                    Margin="0, 0, 0, 10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="75" />
                </Border.StrokeShape>

                <Image Source="logomatutos.jpg" Aspect="AspectFill" WidthRequest="150" HeightRequest="150"/>
            </Border>

            <Label Text="BARBEARIA MATUTOS"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#FFFFFF"/>

            <Label Text="Acesse sua conta para agendar seu horário."
                   FontSize="14"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"
                   Margin="0, -15, 0, 10"/>

            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#333333" 
                    StrokeThickness="1" 
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="E-mail" FontSize="14" FontAttributes="Bold" TextColor="#CCCCCC" />
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                            <Entry Placeholder="exemplo@email.com"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   TextColor="#FFFFFF"
                                   PlaceholderColor="#888888"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Senha" FontSize="14" FontAttributes="Bold" TextColor="#CCCCCC" />
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                            <Entry Placeholder="******"
                                   Text="{Binding Senha}"
                                   IsPassword="True" 
                                   TextColor="#FFFFFF"
                                   PlaceholderColor="#888888"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Botão de Login com o estilo aplicado e propriedades repetidas removidas -->
            <Button Text="Acessar"
                    Command="{Binding LogarCommand}"
                    Style="{StaticResource BotaoCinzaStyle}"
                    Margin="0, 10, 0, 0"/>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0, 10, 0, 0">
                <Label Text="Novo por aqui?" TextColor="#AAAAAA" VerticalOptions="Center"/>
                <Label Text="Cadastre-se" 
                       TextColor="#FFFFFF"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirTelaCommand}"
                          CommandParameter="UsuarioCadastroView"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0, 10, 0, 0">
                <Label Text="Esqueceu a Senha?" TextColor="#AAAAAA" VerticalOptions="Center"/>
                <Label Text="Recuperar Senha" 
                       TextColor="#FFFFFF"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirTelaCommand}"
                          CommandParameter="UsuarioSolicitarCodigoView"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>