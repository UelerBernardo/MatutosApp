<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.ClientePerfilConsultarView"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!-- ESTILO 1: Tons de Cinza (Ação Principal - Ex: Salvar) -->
        <Style x:Key="BotaoCinzaStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E0E0E0" />
            <Setter Property="TextColor" Value="#121212" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="45" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#888888" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- ESTILO 2: Secundário para Popup (Fundo Transparente com Borda - Ex: Cancelar) -->
        <Style x:Key="BotaoSecundarioPopupStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#AAAAAA" />
            <Setter Property="BorderColor" Value="#555555" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="45" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#333333" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout>

                <!-- CABEÇALHO E PERFIL -->
                <Grid BackgroundColor="#121212" Padding="20,50,20,30" RowDefinitions="Auto, Auto">
                    <Label Text="Configurações" TextColor="White" FontSize="26" FontAttributes="Bold"/>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Margin="0,25,0,0">

                        <!-- Foto de Perfil -->
                        <Frame Grid.Column="0" WidthRequest="70" HeightRequest="70" CornerRadius="35"
                               Padding="0" IsClippedToBounds="True" BorderColor="White" BackgroundColor="#2A2A2A">
                            <Image Source="{Binding FotoPerfilSource}" Aspect="AspectFill" />
                        </Frame>

                        <!-- Informações do Usuário -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0" Spacing="2">
                            <Label Text="Olá," TextColor="#AAAAAA" FontSize="14" />
                            <Label Text="{Binding UsuarioPerfil.Nome, TargetNullValue='Carregando...'}" 
                                   TextColor="White" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding UsuarioPerfil.Email}" 
                                   TextColor="#AAAAAA" FontSize="12" />
                        </VerticalStackLayout>

                        <!-- Botão de Editar Foto -->
                        <Frame Grid.Column="2" WidthRequest="40" HeightRequest="40" CornerRadius="20" 
                               BackgroundColor="#1E1E1E" BorderColor="#333333" Padding="0" 
                               VerticalOptions="Center" HorizontalOptions="Center">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AbrirImagemUsuarioCommand}" />
                            </Frame.GestureRecognizers>
                            <Image Source="lapis.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                    </Grid>
                </Grid>

                <!-- CARDS DE AÇÃO -->
                <Grid ColumnDefinitions="*, *" Padding="20,0,20,20" ColumnSpacing="15">

                    <!-- AQUI: Borda alterada para cinza (#333333) -->
                    <Border Grid.Column="0" BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" StrokeShape="RoundRectangle 15" 
                            Padding="15" HeightRequest="110" >
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirAgendamentosCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <Image Source="tesouraclienteperfil.png" HeightRequest="35" WidthRequest="35" Aspect="AspectFit"/>
                            <Label Text="Cortes" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- AQUI: Borda alterada para cinza (#333333) -->
                    <Border Grid.Column="1" BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" StrokeShape="RoundRectangle 15" 
                            Padding="15" HeightRequest="110">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ConsultarTelefoneCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <Image Source="telefoneclienteperfil.png" HeightRequest="35" WidthRequest="35" Aspect="AspectFit"/>
                            <Label Text="Telefone" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- LISTA DE MENU -->
                <VerticalStackLayout BackgroundColor="#121212" Padding="20,0,20,30" Spacing="0">

                    <!-- Meus Dados -->
                    <Grid ColumnDefinitions="*, Auto" Padding="0,18">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirMeusDadosCommand}" />
                        </Grid.GestureRecognizers>
                        <!-- AQUI: TextColor alterado para #E0E0E0 -->
                        <Label Grid.Column="0" Text="Meus Dados" TextColor="#E0E0E0" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text=">" TextColor="#888888" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#2A2A2A" />

                    <!-- Notificações -->
                    <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,18">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirNotificacaoCommand}"/>
                        </Grid.GestureRecognizers>
                        <!-- AQUI: TextColor alterado para #E0E0E0 -->
                        <Label Grid.Column="0" Text="Notificações" TextColor="#E0E0E0" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />

                        <Frame Grid.Column="1" BackgroundColor="#E0E0E0" CornerRadius="12" Padding="8,2" 
                               Margin="0,0,10,0" BorderColor="Transparent" HasShadow="False" VerticalOptions="Center">
                            <Label Text="3" TextColor="#121212" FontSize="12" FontAttributes="Bold" />
                        </Frame>
                        <Label Grid.Column="2" Text=">" TextColor="#888888" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#2A2A2A" />

                    <!-- Status da Conta -->
                    <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,18">
                        <!-- AQUI: TextColor alterado para #E0E0E0 -->
                        <Label Grid.Column="0" Text="Status da Conta" TextColor="#E0E0E0" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding UsuarioPerfil.Ativo, StringFormat='Ativo: {0}'}" 
                               TextColor="#AAAAAA" FontSize="14" VerticalOptions="Center" Margin="0,0,10,0"/>
                        <Label Grid.Column="2" Text=">" TextColor="#888888" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#2A2A2A" />

                    <!-- Alterar Senha -->
                    <Grid ColumnDefinitions="*, Auto" Padding="0,18">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirPopupSenhaCommand}" />
                        </Grid.GestureRecognizers>
                        <!-- AQUI: TextColor alterado para #E0E0E0 -->
                        <Label Grid.Column="0" Text="Alterar Senha" TextColor="#E0E0E0" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text=">" TextColor="#888888" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#2A2A2A" />

                    <!-- Suporte -->
                    <Grid ColumnDefinitions="*, Auto" Padding="0,18">
                        <!-- AQUI: TextColor alterado para #E0E0E0 -->
                        <Label Grid.Column="0" Text="Suporte" TextColor="#E0E0E0" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text=">" TextColor="#888888" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#2A2A2A" />

                    <!-- Sair da Conta -->
                    <Grid ColumnDefinitions="*" Padding="0,25,0,0" Margin="0,10,0,0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogOutCommand}"/>
                        </Grid.GestureRecognizers>
                        <!-- AQUI: TextColor alterado para o tom vermelho padronizado do app (#a15650) -->
                        <Label Text="Sair da Conta" TextColor="#a15650" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- POPUP ALTERAR SENHA -->
        <Grid BackgroundColor="#99000000" 
      IsVisible="{Binding IsPopupSenhaVisivel}" 
      ZIndex="100">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding FecharPopupSenhaCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" 
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            WidthRequest="330" 
            Padding="25" 
            StrokeShape="RoundRectangle 20">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Alterar Senha" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="12">
                        <Entry Placeholder="Senha Atual" IsPassword="True" Text="{Binding SenhaAtual}" 
                       BackgroundColor="#2A2A2A" TextColor="White" PlaceholderColor="#888888" HeightRequest="45" />

                        <!-- BLOCO DA NOVA SENHA COM CHECKLIST -->
                        <VerticalStackLayout Spacing="5">
                            <Entry Placeholder="Nova Senha" IsPassword="True" Text="{Binding NovaSenha}" 
                           BackgroundColor="#2A2A2A" TextColor="White" PlaceholderColor="#888888" HeightRequest="45" />

                            <!-- CHECKLIST DE SENHA FORTE -->
                            <VerticalStackLayout Spacing="2" Margin="5,0,0,5">
                                <Label Text="A nova senha precisa ter:" FontSize="11" FontAttributes="Bold" TextColor="#888888" Margin="0,0,0,2" />

                                <Label Text="• Mínimo de 8 caracteres" FontSize="11" TextColor="#a15650">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding TemTamanhoMinimo}" Value="True">
                                            <Setter Property="TextColor" Value="#4CAF50" />
                                            <Setter Property="Text" Value="✓ Mínimo de 8 caracteres" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="• Pelo menos 1 letra maiúscula" FontSize="11" TextColor="#a15650">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding TemMaiuscula}" Value="True">
                                            <Setter Property="TextColor" Value="#4CAF50" />
                                            <Setter Property="Text" Value="✓ Pelo menos 1 letra maiúscula" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="• Pelo menos 1 número" FontSize="11" TextColor="#a15650">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding TemNumero}" Value="True">
                                            <Setter Property="TextColor" Value="#4CAF50" />
                                            <Setter Property="Text" Value="✓ Pelo menos 1 número" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="• Pelo menos 1 caractere especial" FontSize="11" TextColor="#a15650">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding TemEspecial}" Value="True">
                                            <Setter Property="TextColor" Value="#4CAF50" />
                                            <Setter Property="Text" Value="✓ Caractere especial incluído" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Entry Placeholder="Confirmar Nova Senha" IsPassword="True" Text="{Binding ConfirmarNovaSenha}" 
                       BackgroundColor="#2A2A2A" TextColor="White" PlaceholderColor="#888888" HeightRequest="45" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Cancelar" 
                        Style="{StaticResource BotaoSecundarioPopupStyle}" 
                        Command="{Binding FecharPopupSenhaCommand}" />

                        <Button Grid.Column="1" Text="Salvar" 
                        Style="{StaticResource BotaoCinzaStyle}" 
                        Command="{Binding SalvarNovaSenhaCommand}" 
                        IsEnabled="{Binding SenhaForte}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>