<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.AgendamentoConsultarView"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Estilo do Botão Principal -->
        <Style x:Key="BotaoCinzaStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E0E0E0" />
            <Setter Property="TextColor" Value="#121212" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="45" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#888888" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <!-- Adicionada uma linha extra (o segundo Auto) para o Painel de Filtros -->
    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="0,20,0,0">

        <VerticalStackLayout>
        <!-- LINHA 0: Título -->
        <Label Grid.Row="0"
               Text="Meus"
               FontSize="36"
               FontAttributes="Bold"
               TextColor="#FFFFFF"
               FontFamily="Cursive" 
               HorizontalOptions="Center" 
               Margin="0,0,0,0" />
        <Label Grid.Row="0"
               Text="Agendamentos"
               FontSize="36"
               FontAttributes="Bold"
               TextColor="#FFFFFF"
               FontFamily="Cursive" 
               HorizontalOptions="Center" 
               Margin="0,0,0,15" />
        </VerticalStackLayout>
        <!-- LINHA 1: Painel de Filtros -->
        <Border Grid.Row="1" BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15" Margin="15,0,15,15">
            <VerticalStackLayout Spacing="12">

                <!-- DATAS -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Data Inicial" TextColor="#AAAAAA" FontSize="12" FontAttributes="Bold"/>
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="10,0">
                            <DatePicker Date="{Binding DataInicial}" 
                                        TextColor="White" 
                                        BackgroundColor="Transparent" 
                                        VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Data Final" TextColor="#AAAAAA" FontSize="12" FontAttributes="Bold"/>
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="10,0">
                            <DatePicker Date="{Binding DataFinal}" 
                                        TextColor="White" 
                                        BackgroundColor="Transparent" 
                                        VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- NOME DO BARBEIRO E SITUAÇÃO -->
                <Grid ColumnDefinitions="*, 130" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Barbeiro (Opcional)" TextColor="#AAAAAA" FontSize="12" FontAttributes="Bold"/>
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="10,0">
                            <Entry Text="{Binding NomeBarbeiro}" 
                                   Placeholder="Ex: João" 
                                   TextColor="White" 
                                   PlaceholderColor="#888888" 
                                   BackgroundColor="Transparent" 
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Situação" FontSize="12" FontAttributes="Bold" TextColor="#AAAAAA"/>
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="10,0">
                            <Picker TitleColor="#888888"
                                    ItemsSource="{Binding FiltroSituacao}"
                                    SelectedItem="{Binding SituacaoSelecionada}"
                                    BackgroundColor="Transparent"
                                    TextColor="#FFFFFF"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- BOTÃO PESQUISAR -->
                <Button Text="Pesquisar" 
                        Command="{Binding ConsultarAgendamentosCommand}" 
                        Style="{StaticResource BotaoCinzaStyle}" 
                        Margin="0,5,0,0"/>

            </VerticalStackLayout>
        </Border>

        <!-- LINHA 2: Lista (Ocupa o resto do meio da tela) -->
        <!-- Atualizado para Grid.Row="2" -->
        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding ListaAgendamentos}"
                        SelectionMode="None"
                        Margin="15,0,15,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,50,0,0">
                    <Image Source="meusagendamentos.png" HeightRequest="60" WidthRequest="60"/>
                    <Label Text="Você não possui agendamentos recentes." 
                           TextColor="#AAAAAA" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1E1E1E" Stroke="White" StrokeThickness="1" Padding="15" StrokeShape="RoundRectangle 12">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirDetalhesCommand}"
                                CommandParameter="{Binding Codigo_Agendamento}" />
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="10">

                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Codigo_Agendamento, StringFormat='Agendamento: {0}'}" TextColor="#AAAAAA" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Text=" | " TextColor="#AAAAAA" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Image Source="calendarioagendamento.png" VerticalOptions="Center" HeightRequest="20" WidthRequest="20"/>
                                <Label Text="{Binding Data_Agendamento, StringFormat='{0:dd/MM/yyyy HH:mm}'}" 
                                         FontAttributes="Bold" FontSize="15" TextColor="#FFFFFF" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                <HorizontalStackLayout Spacing="5">
                                    <Image Source="barbeiroagendamento.png" HeightRequest="25" WidthRequest="25" VerticalOptions="Center"/>
                                    <Label Text="Barbeiro" FontSize="15" TextColor="#AAAAAA" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding NomeBarbeiro}" FontSize="15" TextColor="#FFFFFF" FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <Border Grid.Row="1" Grid.Column="1" Padding="8,4" StrokeShape="RoundRectangle 5" StrokeThickness="1" BackgroundColor="#2A2A2A" VerticalOptions="Start">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Codigo_Situacao_Agendamento}" Value="Aberto">
                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Codigo_Situacao_Agendamento}" Value="Cancelado">
                                        <Setter Property="Stroke" Value="#E63946" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Codigo_Situacao_Agendamento}" Value="Liberado">
                                        <Setter Property="Stroke" Value="#2196F3" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Codigo_Situacao_Agendamento}" Value="Concluido">
                                        <Setter Property="Stroke" Value="#4CAF50" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Label Text="{Binding Codigo_Situacao_Agendamento}" FontSize="12" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Codigo_Situacao_Agendamento}" Value="Aberto">
                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Codigo_Situacao_Agendamento}" Value="Cancelado">
                                            <Setter Property="TextColor" Value="#E63946" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Codigo_Situacao_Agendamento}" Value="Liberado">
                                            <Setter Property="TextColor" Value="#2196F3" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Codigo_Situacao_Agendamento}" Value="Concluido">
                                            <Setter Property="TextColor" Value="#4CAF50" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2" Margin="0,10,0,0">
                                <HorizontalStackLayout Spacing="5">
                                    <Image Source="usuarioagendamento.png" HeightRequest="25" WidthRequest="20" VerticalOptions="Center"/>
                                    <Label Text="Cliente" FontSize="15" TextColor="#AAAAAA" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding NomeCliente}" FontSize="15" TextColor="#FFFFFF" FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" HorizontalOptions="End" Spacing="2" VerticalOptions="End">
                                <Label Text="Valor Total" FontSize="12" TextColor="#AAAAAA" HorizontalOptions="End"/>
                                <Label Text="{Binding Valor_Total_Agendamento, StringFormat='R$ {0:F2}'}" 
                                       FontSize="18" TextColor="#4CAF50" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- LINHA 3: Botão Voltar no rodapé -->
        <!-- Atualizado para Grid.Row="3" -->
        <VerticalStackLayout Grid.Row="3" Spacing="0">
            <BoxView HeightRequest="1" Color="#333333" />
            <VerticalStackLayout Spacing="15" Padding="20,10,20,10" BackgroundColor="#121212">
                <Button Text="Voltar"
                        Command="{Binding VoltarTela}"
                        Style="{StaticResource BotaoCinzaStyle}"
                        BackgroundColor="#E0E0E0"
                        TextColor="#121212"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12" />
            </VerticalStackLayout>
        </VerticalStackLayout>

    </Grid>
</ContentPage>