<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.UsuarioImagemView"
             BackgroundColor="#121212"
             Title=""
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!-- ESTILO 1: Escuro com destaque em Vermelho/Vinho (Ideal para cancelar ou ações secundárias) -->
        <Style x:Key="BotaoVermelhoStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#a15650" />
            <Setter Property="BorderColor" Value="#a15650" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="HeightRequest" Value="45" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#a15650" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- ESTILO 2: Tons de Cinza (Ideal para botões de ação principal) -->
        <Style x:Key="BotaoCinzaStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E0E0E0" />
            <Setter Property="TextColor" Value="#121212" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="HeightRequest" Value="45" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#888888" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" BackgroundColor="#121212" Padding="20,50,20,30">
            <Grid ColumnDefinitions="Auto, *">
                <ImageButton Grid.Column="0" 
                             Source="back_arrow_white.png" 
                             WidthRequest="24" 
                             HeightRequest="24" 
                             VerticalOptions="Center" 
                             Command="{Binding CancelarCommand}" 
                             BackgroundColor="Transparent"/>

                <Label Grid.Column="1" 
                       Text="Foto do Perfil" 
                       TextColor="#FFFFFF" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center" 
                       Margin="15,0,0,0"/>
            </Grid>
        </Grid>

        <VerticalStackLayout Grid.Row="1" 
                             Padding="30" 
                             Spacing="20" 
                             VerticalOptions="Center">

            <Label Text="Uma foto ajuda as pessoas a reconhecerem você e permite saber quando você está conectado."
                   TextColor="#AAAAAA"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20"/>

            <Border StrokeShape="RoundRectangle 100"
                    Stroke="#333333"
                    StrokeThickness="2"
                    BackgroundColor="#1E1E1E"
                    HorizontalOptions="Center"
                    HeightRequest="200"
                    WidthRequest="200">

                <Grid>
                    <Image Source="{Binding FotoPerfilSource}"
                           Aspect="AspectFill"
                           HeightRequest="200"
                           WidthRequest="200"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#FFFFFF"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"/>
                </Grid>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="0,30,0,0">

                <!-- Botão Mudar com Estilo Cinza -->
                <Button Text="Mudar"
                        ImageSource="edit_icon.png"
                        Command="{Binding EscolherImagemCommand}"
                        Style="{StaticResource BotaoCinzaStyle}"
                        WidthRequest="130"/>

                <!-- Botão Cancelar com Estilo Vermelho Padronizado -->
                <Button Text="Cancelar"
                        ImageSource="trash_icon.png"
                        Command="{Binding CancelarCommand}"
                        Style="{StaticResource BotaoVermelhoStyle}"
                        WidthRequest="130"/>

            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Frame Grid.Row="2" 
               BackgroundColor="#1E1E1E" 
               HasShadow="False" 
               BorderColor="#333333"
               Padding="20">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Label Text="🌐" FontSize="18"/>
                <Label Text="Visível para todos os usuários do sistema" 
                       TextColor="#AAAAAA" 
                       FontSize="13"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Frame>

    </Grid>
</ContentPage>