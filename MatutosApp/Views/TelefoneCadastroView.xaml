<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.TelefoneCadastroView"
             BackgroundColor="#121212"
             Title=""
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="20,40,20,40">

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,0,0,10">
                <Image Source="telefonebranco.png" WidthRequest="100" HeightRequest="100"/>
                <Label Text="Qual é o seu número?"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#FFFFFF"/>
                <Label Text="Para enviar lembretes dos seus agendamentos."
                       FontSize="14"
                       TextColor="#AAAAAA"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#333333" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="20">

                <VerticalStackLayout Spacing="20">

                    <Grid ColumnDefinitions="0.3*, 0.7*" ColumnSpacing="15">

                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="DDD" FontSize="14" FontAttributes="Bold" TextColor="#CCCCCC" />
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="5,0">
                                <Entry Placeholder="Ex: 17"
                                       Text="{Binding Ddd}" 
                                       Keyboard="Numeric"
                                       MaxLength="2"
                                       TextColor="#FFFFFF"
                                       PlaceholderColor="#888888"
                                       BackgroundColor="Transparent"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Número" FontSize="14" FontAttributes="Bold" TextColor="#CCCCCC" />
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                                <Entry Placeholder="99999-9999"
                                       Text="{Binding Numero_telefone}" 
                                       Keyboard="Telephone"
                                       MaxLength="10"
                                       TextColor="#FFFFFF"
                                       PlaceholderColor="#888888"
                                       BackgroundColor="Transparent"
                                       ClearButtonVisibility="WhileEditing"
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Número principal?" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Label Text="Sua preferência para contato." FontSize="12" TextColor="#888888" />
                        </VerticalStackLayout>

                        <Switch Grid.Column="1" 
                                IsToggled="{Binding Principal}" 
                                ThumbColor="#FFFFFF" 
                                OnColor="#4CAF50" 
                                IsEnabled="{Binding PodeEditarPrincipal}"
                                VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="15" Margin="0,10,0,0">

                <Button Text="{Binding NomeBotaoAcao}"
                        Command="{Binding CadastrarOuAlterarCommand}"
                        BackgroundColor="#E0E0E0"
                        TextColor="#121212"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="55" />

                <Button Text="Cancelar"
                        Command="{Binding VoltarTela}"
                        BackgroundColor="Transparent"
                        TextColor="#AAAAAA"
                        BorderColor="#333333"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="55" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>