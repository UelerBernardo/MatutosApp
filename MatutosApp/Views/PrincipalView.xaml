<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MatutosApp.Views"
             x:Class="MatutosApp.Views.PrincipalView"
             BackgroundColor="#121212">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">

            <Grid RowDefinitions="Auto, Auto" Margin="0, 40, 0, 10">
                <ImageButton Source="gear.png" 
                             WidthRequest="20" 
                             HeightRequest="20" 
                             HorizontalOptions="End" 
                             VerticalOptions="Start"
                             Command="{Binding PerfilAbrirCommand}"/>

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 50" 
                            Stroke="#888888" StrokeThickness="2" 
                            WidthRequest="150" 
                            HeightRequest="150" 
                            HorizontalOptions="Center">
                        <Image Source="barbearialogo.jpeg" Aspect="AspectFill" WidthRequest="150" HeightRequest="150" HorizontalOptions="Center"/> 
                    </Border>

                    <Label Text="{Binding UsuarioPerfil.Nome}"
                           Margin="0,20,0,0"
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#FFFFFF" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" Color="#333333" Margin="0, 1" />
            <Label Text="Menu" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#CCCCCC" HorizontalOptions="Center" 
                   Margin="0, 0, 0, 10" />

            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="20" RowSpacing="20">

                <Border Grid.Row="0" Grid.Column="0" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirAgendamentoCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Image Source="tesoura.png" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" />
                        <Label Text="Agendar" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" 
                        Stroke="#333333" 
                        StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MeusAgendamentosCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Image Source="meusagendamento.png" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" />
                        <Label Text="Meus Agendamentos" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" 
                        Stroke="#333333" 
                        StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirLocalizacaoCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Image Source="localizacao.png" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" />
                        <Label Text="Localização" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" 
                        Stroke="#333333" 
                        StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirServicoCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Image Source="servicos.png" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" />
                        <Label Text="Serviços" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button Text="Sair" 
                    BackgroundColor="#E0E0E0" TextColor="#121212" FontAttributes="Bold" 
                    CornerRadius="25" 
                    HeightRequest="50" 
                    WidthRequest="200" 
                    HorizontalOptions="Center" 
                    Margin="0, 20, 0, 30" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>