<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MatutosApp.Views"
             x:Class="MatutosApp.Views.PrincipalView"
             Title="PrincipalView">
    <VerticalStackLayout>
        <Button Text="ENTRAR"
          Command="{Binding AbrirAgendamentoCommand}"
          BackgroundColor="#2B0B3F"
          TextColor="White"
          FontAttributes="Bold"
          CornerRadius="8"
          HeightRequest="55"
          Margin="0, 10, 0, 0"/>

        <Label Text="Cadastre-se" 
        TextColor="#2B0B3F"
        FontAttributes="Bold"
        VerticalOptions="Center"
        TextDecorations="Underline">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AbrirTela}"
                               CommandParameter="{x:Type TypeName=views:AgendamentoCadastroView}"/>
            </Label.GestureRecognizers>
        </Label>
    </VerticalStackLayout>
</ContentPage>