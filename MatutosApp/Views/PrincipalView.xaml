<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MatutosApp.Views"
             x:Class="MatutosApp.Views.PrincipalView"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <!-- Cabeçalho (Engrenagem e Logo) -->
            <Grid ColumnDefinitions="60, *, 60" Margin="0, 20, 0, 10">
                <ImageButton Grid.Column="0"
                             Source="configuracaobarbearia.png"
                             WidthRequest="5"
                             HeightRequest="5"
                             VerticalOptions="Start"
                             HorizontalOptions="Start"
                             BackgroundColor="Transparent"
                             Command="{Binding PerfilAbrirCommand}" />

                <VerticalStackLayout Grid.Column="1" Spacing="15" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 75" 
                            Stroke="#121212" 
                            StrokeThickness="2" 
                            WidthRequest="200" 
                            HeightRequest="200" 
                            BackgroundColor="#1E1E1E"
                            HorizontalOptions="Center">
                        <Image Source="logomatutos.jpg" Aspect="AspectFill" WidthRequest="198" HeightRequest="198"/>
                    </Border>
                </VerticalStackLayout>

                <BoxView Grid.Column="2" Color="Transparent" />
            </Grid>

            <BoxView HeightRequest="1" Color="#333333" Margin="0, 10" />

            <Label Text="Menu" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#AAAAAA" 
                   HorizontalOptions="Center" 
                   Margin="0, 0, 0, 10" />

            <!-- Grid de Botões do Menu -->
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="15" RowSpacing="15">

                <!-- Botão: Agendar -->
                <Border Grid.Row="0" Grid.Column="0" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" Stroke="#FFFFFF" StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirAgendamentoCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                        <Image Source="agendarbarbearia.png" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" />
                        <Label Text="Agendar" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Botão: Agendamentos -->
                <Border Grid.Row="0" Grid.Column="1"
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" Stroke="#FFFFFF" StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MeusAgendamentosCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                        <Image Source="agendamentosbranco.png" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" />
                        <Label Text="Agendamentos" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Botão: Serviços -->
                <Border Grid.Row="1" Grid.Column="0" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" Stroke="#FFFFFF" StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirServicoCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                        <Image Source="servicosbarbearia.png" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" />
                        <Label Text="Serviços" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Botão: Localização -->
                <Border Grid.Row="1" Grid.Column="1" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" Stroke="#FFFFFF" StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirLocalizacaoCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                        <Image Source="localizacaobranca.png" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" />
                        <Label Text="Localização" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Botão: Usuários -->
                <Border Grid.Row="2" Grid.Column="0" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" Stroke="#FFFFFF" StrokeThickness="1" 
                        HeightRequest="140"
                        IsVisible="{Binding PodeVisualizar}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirUsuarioCadastroCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                        <Image Source="usuariosistema.png" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" />
                        <Label Text="Usuários" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Botão: Bloqueio -->
                <Border Grid.Row="2" Grid.Column="1" 
                     StrokeShape="RoundRectangle 20" 
                     BackgroundColor="#1E1E1E" Stroke="#FFFFFF" StrokeThickness="1" 
                     HeightRequest="140"
                     IsVisible="{Binding PodeVisualizar}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirBlacklistCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                        <Image Source="bloqueiovermelho.png" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" />
                        <Label Text="Bloqueio" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Botão: Notificação -->
                <Border Grid.Row="3" Grid.Column="0" 
                         StrokeShape="RoundRectangle 20" 
                         BackgroundColor="#1E1E1E" Stroke="#FFFFFF" StrokeThickness="1" 
                         HeightRequest="140"
                         IsVisible="{Binding PodeVisualizar}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirNotificacoesCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                        <Image Source="notificacaobranco.png" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" />
                        <Label Text="Notificação" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>
            <VerticalStackLayout>
                <ImageButton Source="sair.png" WidthRequest="70" HeightRequest="70" BackgroundColor="#121212" Command="{Binding LogOutCommand}" Margin="0,50,0,0"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>