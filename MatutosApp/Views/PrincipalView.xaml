<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MatutosApp.Views"
             x:Class="MatutosApp.Views.PrincipalView"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Grid ColumnDefinitions="60, *, 60" Margin="0, 20, 0, 10">
                <ImageButton Grid.Column="0"
                             Source="engrenagembraca.png"
                             WidthRequest="80"
                             HeightRequest="80"
                             VerticalOptions="Start"
                             HorizontalOptions="Start"
                             BackgroundColor="Transparent"
                             Command="{Binding PerfilAbrirCommand}" />

                <VerticalStackLayout Grid.Column="1" Spacing="15" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 75" 
                            Stroke="#333333" 
                            StrokeThickness="2" 
                            WidthRequest="200" 
                            HeightRequest="200" 
                            BackgroundColor="#1E1E1E"
                            HorizontalOptions="Center">
                        <Image Source="logomatutos.jpg" Aspect="AspectFill" WidthRequest="198" HeightRequest="198"/>
                    </Border>
                </VerticalStackLayout>

                <BoxView Grid.Column="2" Color="Transparent" />
            </Grid>

            <BoxView HeightRequest="1" Color="#333333" Margin="0, 10" />

            <Label Text="Menu Principal" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#AAAAAA" 
                   HorizontalOptions="Center" 
                   Margin="0, 0, 0, 10" />

            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="15" RowSpacing="15">

                <Border Grid.Row="0" Grid.Column="0" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirAgendamentoCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Image Source="tesoura.png" WidthRequest="75" HeightRequest="60" HorizontalOptions="Center" />
                        <Label Text="Agendar" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MeusAgendamentosCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Image Source="meusagendamento.png" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center" />
                        <Label Text="Meus Agendamentos" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" TextType="Html" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirServicoCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Image Source="servicos.png" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center" />
                        <Label Text="Serviços" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" 
                        HeightRequest="140">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirLocalizacaoCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Image Source="localizacao.png" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center" />
                        <Label Text="Localização" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" 
                        HeightRequest="120"
                        IsVisible="{Binding PodeVisualizar}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirUsuarioCadastroCommand}"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                        <Image Source="usuario.png" WidthRequest="90" HeightRequest="90" VerticalOptions="Center" />
                        <Label Text="Usuários do Sistema" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Button Text="Sair" 
                    BackgroundColor="#E0E0E0" 
                    TextColor="#121212" 
                    FontAttributes="Bold" 
                    CornerRadius="25" 
                    HeightRequest="55" 
                    WidthRequest="200" 
                    HorizontalOptions="Center" 
                    Margin="0, 30, 0, 30"
                    Command="{Binding LogOutCommand}" />

            <Button Text="blacklist" 
                BackgroundColor="#E0E0E0" 
                TextColor="#121212" 
                FontAttributes="Bold" 
                CornerRadius="25" 
                HeightRequest="55" 
                WidthRequest="200" 
                HorizontalOptions="Center" 
                Margin="0, 30, 0, 30"
                Command="{Binding AbrirBlacklistCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>