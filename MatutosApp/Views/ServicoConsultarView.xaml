<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.ServicoConsultarView">

    <Grid RowDefinitions="Auto, *, Auto">

        <CollectionView ItemsSource="{Binding ListaServicos}" 
                    SelectionMode="Single"
                    Grid.Row="1"
                    SelectedItem="{Binding ServicoSelecionado}"
                    Margin="20,20,20,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" Grid.Row="1" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate >
                <DataTemplate>

                    <Border Stroke="#333333" 
                        StrokeThickness="1" 
                        BackgroundColor="#1E1E1E"
                        StrokeShape="RoundRectangle 16" 
                        Padding="15">

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">

                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">

                                <Label Text="{Binding Descricao}" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#FFFFFF"/>

                                <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}" 
                                   FontSize="15" 
                                   TextColor="#E0E0E0" 
                                   FontAttributes="Bold"/>

                                <HorizontalStackLayout Spacing="5">
                                    <Image Source="relogioagendar.png" HeightRequest="14" WidthRequest="14" VerticalOptions="Center"/>
                                    <Label Text="{Binding Duracao}" 
                                       FontSize="12" 
                                       TextColor="#888888"
                                       VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                            <Label Grid.Column="1" 
                               Text=">" 
                               TextColor="#555555" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               VerticalOptions="Center" />

                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <BoxView HeightRequest="1" Color="#333333" />

            <VerticalStackLayout Spacing="15" Padding="20,20,20,30" BackgroundColor="#121212">

                <Button Text="Cadastrar Serviço"
                  Command="{Binding AbrirCadastroServicoCommand}"
                  BackgroundColor="#E0E0E0"
                  TextColor="#121212"
                  FontAttributes="Bold"
                  FontSize="16"
                  CornerRadius="25"
                  HeightRequest="55" />

            </VerticalStackLayout>
        </VerticalStackLayout>

    </Grid>

</ContentPage>