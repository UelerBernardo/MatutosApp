<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.ServicoConsultarView"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Padding="20,40,20,10" Spacing="5">
            <Label Text="Nossos Serviços" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center"/>
            <Label Text="Clique em um serviço para ver as fotos" FontSize="14" TextColor="#AAAAAA" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding ListaServicos}" 
                        SelectionMode="None"
                        Margin="20,10,20,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#333333" 
                            StrokeThickness="1" 
                            BackgroundColor="#1E1E1E"
                            StrokeShape="RoundRectangle 16" 
                            Padding="15">

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConsultarServicoImagensCommand}" 
                                                      CommandParameter="{Binding Codigo_Servico}" />
                            </Grid.GestureRecognizers>

                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Descricao}" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}" FontSize="15" TextColor="#4CAF50" FontAttributes="Bold"/>

                                <HorizontalStackLayout Spacing="5" Margin="0,4,0,0">
                                    <Label Text="⏱️" FontSize="12" VerticalOptions="Center"/>
                                    <Label Text="{Binding Duracao}" FontSize="12" TextColor="#888888" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Label Grid.Column="1" Text=">" TextColor="#555555" FontSize="20" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <BoxView HeightRequest="1" Color="#333333" />
            <VerticalStackLayout Spacing="15" Padding="20,20,20,30" BackgroundColor="#121212">
                <Button Text="Cadastrar Novo Serviço"
                        Command="{Binding AbrirCadastroServicoCommand}"
                        BackgroundColor="#E0E0E0"
                        TextColor="#121212"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="25"
                        HeightRequest="55" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.RowSpan="3" BackgroundColor="#DD000000" IsVisible="{Binding MostrarGaleria}" InputTransparent="False">

            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#333333" StrokeThickness="1" StrokeShape="RoundRectangle 20" 
                    VerticalOptions="Center" HorizontalOptions="Center" 
                    WidthRequest="340" Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label Text="Fotos do Serviço" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center"/>

                    <CollectionView ItemsSource="{Binding ListaImagensServico}" HeightRequest="220">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" SnapPointsType="MandatorySingle" SnapPointsAlignment="Center" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                                <Label Text="✂️" FontSize="40" HorizontalOptions="Center"/>
                                <Label Text="Nenhuma foto cadastrada." TextColor="#AAAAAA" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12" Stroke="#333333" StrokeThickness="1" BackgroundColor="#2A2A2A" WidthRequest="220" HeightRequest="220">
                                    <Image Source="{Binding FonteImagem}" Aspect="AspectFill" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="Fechar Galeria" 
                            Command="{Binding FecharGaleriaCommand}" 
                            BackgroundColor="Transparent" 
                            BorderColor="#555555" BorderWidth="1" 
                            TextColor="#E0E0E0" FontAttributes="Bold" 
                            CornerRadius="12" HeightRequest="45"/>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>