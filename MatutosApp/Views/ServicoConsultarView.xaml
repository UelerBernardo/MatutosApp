<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.ServicoConsultarView"
             xmlns:viewmodels="clr-namespace:MatutosApp.ViewsModels"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False"
             x:Name="PaginaConsultaServico">

    <ContentPage.Resources>

        <!-- ESTILO 1: Escuro com destaque em Vermelho/Vinho -->
        <Style x:Key="BotaoVermelhoStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1E1E1E" />
            <Setter Property="TextColor" Value="#a15650" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="8" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#a15650" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- ESTILO 2: Tons de Cinza -->
        <Style x:Key="BotaoCinzaStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E0E0E0" />
            <Setter Property="TextColor" Value="#121212" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="8" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#888888" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- CABEÇALHO -->
        <VerticalStackLayout Grid.Row="0" Padding="20,40,20,10" Spacing="5">
            <Label Text="Nossos Serviços" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center"/>
            <Label Text="Clique em um serviço para ver as fotos" FontSize="14" TextColor="#AAAAAA" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- LISTA DE SERVIÇOS -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding ListaServicos}" 
                        SelectionMode="Single" 
                        SelectedItem="{Binding ServicoClicado}"
                        Margin="20,10,20,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="White" StrokeThickness="1" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 16" Padding="15">

                        <VerticalStackLayout Spacing="0">

                            <!-- Grid principal do card organizado -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">

                                <!-- Textos e Duração (Coluna 0) -->
                                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Descricao}" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                    <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}" FontSize="15" TextColor="#a15650" FontAttributes="Bold"/>
                                    <HorizontalStackLayout Spacing="5" Margin="0,4,0,0">
                                        <Image Source="relogioagendar.png" HeightRequest="20" WidthRequest="20"/>
                                        <Label Text="{Binding Duracao}" FontSize="12" TextColor="#888888" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Ações à Direita (Coluna 1): Botão Alterar e Ícone de Câmera empilhados -->
                                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Image Source="camerabranca.png" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" />

                                    <!-- Exemplo usando o Estilo Vermelho no botão Alterar -->
                                    <Button Text="Alterar"
                                            Style="{StaticResource BotaoVermelhoStyle}"
                                            IsVisible="{Binding BindingContext.PodeVisualizar, Source={x:Reference PaginaConsultaServico}}"
                                            FontSize="12"
                                            HeightRequest="30"
                                            Padding="12,0"
                                            BorderColor="White"
                                            BackgroundColor="White"
                                            CornerRadius="18"
                                            Command="{Binding BindingContext.AbrirAlteracaoServicoCommand, Source={x:Reference PaginaConsultaServico}}" 
                                            CommandParameter="{Binding .}"/>
                                </VerticalStackLayout>

                            </Grid>

                            <!-- Seção Expansível de Fotos -->
                            <VerticalStackLayout IsVisible="{Binding IsExpanded}" Margin="0,15,0,0" Spacing="15">

                                <BoxView HeightRequest="1" Color="#333333" />

                                <ActivityIndicator IsRunning="{Binding IsCarregando}" 
                                                   IsVisible="{Binding IsCarregando}" 
                                                   Color="#E0E0E0" 
                                                   HorizontalOptions="Center" 
                                                   HeightRequest="30" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ImagensDoServico}" Spacing="15">

                                    <BindableLayout.EmptyView>
                                        <Label Text="Nenhuma foto cadastrada." 
                                               TextColor="#666666" 
                                               HorizontalOptions="Center"
                                               Margin="0,10,0,10" />
                                    </BindableLayout.EmptyView>

                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeShape="RoundRectangle 12" 
                                                    Stroke="#333333" 
                                                    StrokeThickness="1" 
                                                    BackgroundColor="#2A2A2A" 
                                                    HeightRequest="250" 
                                                    HorizontalOptions="Fill">

                                                <Image Source="{Binding FonteImagem}" Aspect="AspectFill" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- RODAPÉ COM OS BOTÕES -->
        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <BoxView HeightRequest="1" Color="#333333" />
            <VerticalStackLayout Spacing="15" Padding="20,10,20,10" BackgroundColor="#121212">

                <!-- Botão Novo Serviço com Estilo Cinza -->
                <Button Text="Novo Serviço"
                        IsVisible="{Binding PodeVisualizar}"
                        Command="{Binding AbrirCadastroServicoCommand}"
                        Style="{StaticResource BotaoCinzaStyle}" />

                <!-- Botão Voltar com Estilo Cinza -->
                <Button Text="Voltar"
                        Command="{Binding VoltarTela}"
                        Style="{StaticResource BotaoCinzaStyle}" />
            </VerticalStackLayout>
        </VerticalStackLayout>

    </Grid>
</ContentPage>