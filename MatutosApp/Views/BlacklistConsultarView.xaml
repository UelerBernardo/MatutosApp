<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.BlacklistConsultarView"
             x:Name="PaginaConsultaBlacklist"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Padding="20,40,20,10" Spacing="5">
            <Label Text="Bloqueios de Agenda" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center"/>
            <Label Text="Gerenciamento de ausências e horários fechados" FontSize="14" TextColor="#AAAAAA" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding ListaBlacklist}" 
                        SelectionMode="None" 
                        Margin="20,10,20,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 16" Padding="15">

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">

                            <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">

                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Codigo_BlackList}" FontSize="17" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                    <Label Text="- Período Bloqueado" FontSize="17" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Início:" FontSize="14" TextColor="#AAAAAA" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Text="{Binding Inicio_Bloqueio, StringFormat='{0:dd/MM/yyyy às HH:mm}'}" FontSize="14" TextColor="#a15650" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Fim:" FontSize="14" TextColor="#AAAAAA" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Text="{Binding Fim_Bloqueio, StringFormat='{0:dd/MM/yyyy às HH:mm}'}" FontSize="14" TextColor="#a15650" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Spacing="2" Margin="0,4,0,0">
                                    <Label Text="Motivo / Detalhes:" FontSize="12" TextColor="#AAAAAA" FontAttributes="Bold"/>
                                    <Label Text="{Binding Detalhes}" FontSize="14" TextColor="#FFFFFF" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>

                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">

                                <Button Text="Detalhes"
                                        TextColor="White" 
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="40"
                                        WidthRequest="88"
                                        VerticalOptions="Center" 
                                        BackgroundColor="#a15650" 
                                        Command="{Binding BindingContext.AbrirAlteracaoBlacklistCommand, Source={x:Reference PaginaConsultaBlacklist}}" 
                                        CommandParameter="{Binding .}"/>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <BoxView HeightRequest="1" Color="#333333" />
            <VerticalStackLayout Spacing="15" Padding="20,20,20,30" BackgroundColor="#121212">
                <Button Text="Novo Bloqueio de Agenda"
                        Command="{Binding AbrirBlacklistCadastroCommand}"
                        BackgroundColor="#E0E0E0"
                        TextColor="#121212"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="25"
                        HeightRequest="55" />
                <Button Text="Voltar"
                        Command="{Binding VoltarTela}"
                        BackgroundColor="#E0E0E0"
                        TextColor="#121212"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="25"
                        HeightRequest="55" />
            </VerticalStackLayout>
        </VerticalStackLayout>

    </Grid>
</ContentPage>