<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.ConfiguraNotificacaoCadastrarView"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Estilo do Botão Principal (Ação de Salvar - Verde) -->
        <Style x:Key="BotaoVerdeStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#4CAF50" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <!-- Escurece o verde ao clicar -->
                                <Setter Property="BackgroundColor" Value="#388E3C" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- Estilo do Botão Secundário (Cancelar/Voltar - Vazado) -->
        <Style x:Key="BotaoContornoStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderColor" Value="#333333" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="TextColor" Value="#AAAAAA" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <!-- Preenche com fundo escuro e acende o texto ao clicar -->
                                <Setter Property="BackgroundColor" Value="#1E1E1E" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30">

            <Label Text="{Binding Titulo}"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#FFFFFF" 
                   Margin="0,0,0,10"/>

            <VerticalStackLayout Spacing="8">
                <Label Text="Descrição" FontSize="14" FontAttributes="Bold" TextColor="#CCCCCC" />
                <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                    <Entry Placeholder="Ex: Aviso 20 minutos antes"
                           Text="{Binding Descricao}"
                           TextColor="#FFFFFF"
                           PlaceholderColor="#888888"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"/>
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                <VerticalStackLayout Spacing="8" Grid.Column="0">
                    <Label Text="Tipo de Evento" FontSize="14" FontAttributes="Bold" TextColor="#CCCCCC" />
                    <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="10,0">
                        <Picker 
                            ItemsSource="{Binding TiposEventos}"
                            ItemDisplayBinding="{Binding Nome}"
                            SelectedItem="{Binding TipoSelecionado}"
                            IsEnabled="{Binding PodeEditar}"
                            TextColor="#FFFFFF"
                            TitleColor="#888888"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" Grid.Column="1">
                    <Label Text="Status da Regra" FontSize="14" FontAttributes="Bold" TextColor="#CCCCCC" />

                    <HorizontalStackLayout Spacing="0" VerticalOptions="Center" HorizontalOptions="Start">

                        <Label Text="Ativa" TextColor="White" VerticalOptions="Center" FontSize="15" Margin="20"/>
                        <Switch IsToggled="{Binding Ativo}" OnColor="#4CAF50" VerticalOptions="Center" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                <VerticalStackLayout Spacing="8" Grid.Column="0" IsVisible="{Binding IsValorVisivel}">
                    <Label Text="Valor (Tempo)" FontSize="14" FontAttributes="Bold" TextColor="#CCCCCC" />
                    <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="15,0">
                        <Entry Placeholder="Ex: 20"
                               Text="{Binding Valor}"
                               IsEnabled="{Binding IsValorHabilitado}"
                               Keyboard="Numeric"
                               TextColor="#FFFFFF"
                               PlaceholderColor="#888888"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" Grid.Column="1" IsVisible="{Binding IsUnidadeTempoVisivel}">
                    <Label Text="Unidade Tempo" FontSize="14" FontAttributes="Bold" TextColor="#CCCCCC" />
                    <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="50" Padding="10,0">
                        <Picker ItemsSource="{Binding UnidadesDeTempo}"
                                SelectedItem="{Binding UnidadeTempo}"
                                IsEnabled="{Binding IsUnidadeTempoHabilitada}"
                                TextColor="#FFFFFF"
                                TitleColor="#888888"        
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

            </Grid>

            <VerticalStackLayout Spacing="8">
                <Label Text="Mensagem para o Cliente" FontSize="14" FontAttributes="Bold" TextColor="#CCCCCC" />
                <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="100" Padding="15,10">
                    <Editor Placeholder="Digite o texto da notificação..."
                            Text="{Binding Mensagem}"
                            TextColor="#FFFFFF"
                            PlaceholderColor="#888888"
                            BackgroundColor="Transparent"/>
                </Border>
            </VerticalStackLayout>

            <!-- Agrupamento dos botões com os novos estilos -->
            <VerticalStackLayout Spacing="15" Margin="0, 20, 0, 0">

                <Button Text="{Binding NomeBotaoAcao}"
                        Command="{Binding SalvarRegraCommand}"
                        Style="{StaticResource BotaoVerdeStyle}"
                        HeightRequest="55"/>

                <!-- Botão para voltar/cancelar a ação já que não há NavBar -->
                <Button Text="Cancelar"
                        Command="{Binding VoltarTela}"
                        Style="{StaticResource BotaoContornoStyle}"
                        HeightRequest="55"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>