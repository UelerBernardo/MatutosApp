<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.UsuarioTelefoneConsultarView"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" BackgroundColor="#121212" Padding="20,50,20,30">
            <Grid ColumnDefinitions="Auto, *">
                <ImageButton Grid.Column="0" 
                             Source="back_arrow_white.png" 
                             WidthRequest="24" 
                             HeightRequest="24" 
                             VerticalOptions="Center" 
                             Command="{Binding VoltarCommand}" 
                             BackgroundColor="Transparent"/>

                <Label Grid.Column="1" 
                       Text="Meus Telefones" 
                       TextColor="#FFFFFF" 
                       FontSize="22"  
                       HorizontalTextAlignment="Center"
                       FontAttributes="Bold" 
                       VerticalOptions="Center" 
                       Margin="0,0,0,15"/>
            </Grid>
        </Grid>

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding ListaTelefone}" 
                        SelectionMode="None"
                        Margin="20,0,20,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15" Margin="0,50,0,0">
                    <Label Text="📵" FontSize="60" HorizontalOptions="Center" />
                    <Label Text="Você não possui nenhum" FontSize="18" TextColor="#AAAAAA" HorizontalOptions="Center" />
                    <Label Text="telefone cadastrado." FontSize="18" TextColor="#AAAAAA" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1E1E1E" 
                            Stroke="#333333" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 12" 
                            Padding="15">

                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">

                            <Frame Grid.Column="0" BackgroundColor="#2A2A2A" CornerRadius="25" 
                                   WidthRequest="50" HeightRequest="50" Padding="0" HasShadow="False" BorderColor="Transparent" VerticalOptions="Center">
                             
                                <Image Source="telefonebranco.png" WidthRequest="40"/>
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">

                                <Label Text="{Binding Usuario.Nome}" TextColor="#AAAAAA" FontSize="12" />

                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Telefone.DDD, StringFormat='({0})'}" TextColor="#FFFFFF" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding Telefone.Numero_Telefone}" TextColor="#FFFFFF" FontSize="16" FontAttributes="Bold" />
                                </HorizontalStackLayout>

                                <Border IsVisible="{Binding Telefone.Principal}" 
                                        BackgroundColor="#1A3320" 
                                        Stroke="#4CAF50" 
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 5" 
                                        Padding="6,2" 
                                        HorizontalOptions="Start" 
                                        Margin="0,2,0,0">
                                    <Label Text="Principal" TextColor="#4CAF50" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </VerticalStackLayout>

                            <ImageButton Grid.Column="2"
                                         Source="lapis.png"
                                         BackgroundColor="Transparent"
                                         WidthRequest="25"
                                         HeightRequest="10"
                                         VerticalOptions="Center"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirAlteracaoTelefoneCommand}"
                                         CommandParameter="{Binding Telefone}" />

                            <ImageButton Grid.Column="3"
                                         Source="xvermelho.png"
                                         BackgroundColor="Transparent"
                                         WidthRequest="5"
                                         HeightRequest="5"
                                         VerticalOptions="Center"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ExcluirTelefoneCommand}"
                                         CommandParameter="{Binding Codigo_Telefone}" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <BoxView HeightRequest="1" Color="#333333" />
            <Grid Padding="20,10,20,15" BackgroundColor="#121212">
                <Button Text="Adicionar Novo Telefone" 
                        BackgroundColor="#E0E0E0" 
                        TextColor="#121212" 
                        CornerRadius="12" 
                        FontAttributes="Bold" 
                        FontSize="16"
                        Command="{Binding AbrirAdicionarTelefoneCommand}"/>
            </Grid>
        </VerticalStackLayout>

    </Grid>
</ContentPage>