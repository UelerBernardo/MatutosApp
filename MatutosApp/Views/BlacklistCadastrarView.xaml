<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.BlacklistCadastrarView"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#121212">
    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,30" Spacing="20">

            <VerticalStackLayout Spacing="5" Margin="0,0,0,10">
                <Label Text="Novo Bloqueio" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center"/>
                <Label Text="Desabilite horários na agenda do sistema" FontSize="14" TextColor="#AAAAAA" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               Color="#E0E0E0" 
                               HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Motivo do Bloqueio" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" />
                <Border Stroke="#333333" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 12" Padding="15,0">
                    <Entry Text="{Binding Detalhes}" 
                           Placeholder="Ex: Almoço, Feriado, Reunião..." 
                           TextColor="#FFFFFF" 
                           PlaceholderColor="#666666" 
                           ClearButtonVisibility="WhileEditing" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="Início" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" />

                    <Border Stroke="#333333" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 12" Padding="15,0" HeightRequest="50">
                        <DatePicker Date="{Binding Inicio_Bloqueio}" TextColor="#FFFFFF" VerticalOptions="Center" />
                    </Border>

                    <Border Stroke="#333333" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 12" Padding="15,0" HeightRequest="50">
                        <TimePicker Time="{Binding HoraInicio_Bloqueio}" TextColor="#FFFFFF" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="8">
                    <Label Text="Fim" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16" />

                    <Border Stroke="#333333" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 12" Padding="15,0" HeightRequest="50">
                        <DatePicker Date="{Binding Fim_Bloqueio}" TextColor="#FFFFFF" VerticalOptions="Center" />
                    </Border>

                    <Border Stroke="#333333" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 12" Padding="15,0" HeightRequest="50">
                        <TimePicker Time="{Binding HoraFim_Bloqueio}" TextColor="#FFFFFF" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

            </Grid>

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Margin="0,5">
                <Switch IsToggled="{Binding Ativo}" ThumbColor="#a15650" OnColor="#333333" />
                <Label Text="Bloqueio Ativo no Sistema" TextColor="#FFFFFF" VerticalOptions="Center" FontSize="16" />
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

            <VerticalStackLayout Spacing="10">
                <Label Text="Selecione os Barbeiros:" TextColor="#FFFFFF" FontSize="18" FontAttributes="Bold" />

                <Border Stroke="#333333" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 12" Padding="15">
                    <CollectionView ItemsSource="{Binding ListaBarbeiro}">

                        <CollectionView.EmptyView>
                            <Label Text="Nenhum barbeiro encontrado." TextColor="#666666" HorizontalOptions="Center" Margin="10" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="15" Margin="0,8">
                                    <CheckBox IsChecked="{Binding IsSelecionado}" Color="#a15650" VerticalOptions="Center" />
                                    <Label Text="{Binding Nome}" TextColor="#FFFFFF" FontSize="16" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="15" Margin="0, 30, 0, 0">
                <Button Text="Salvar Bloqueio" 
                        Command="{Binding CadastrarBlacklistCommand}" 
                        BackgroundColor="#a15650" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="16"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>