<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.AuditoriaLogConsultarView"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False"
             Title="Logs de Auditoria">

    <ContentPage.Resources>
        <!-- Estilo do Botão Principal -->
        <Style x:Key="BotaoCinzaStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E0E0E0" />
            <Setter Property="TextColor" Value="#121212" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="45" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#888888" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" Padding="15" RowSpacing="15">

        <!-- PAINEL DE FILTROS (Linha 0) -->
        <VerticalStackLayout Grid.Row="0" Spacing="15">

            <Label Text="Auditoria do Sistema" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#FFFFFF"
                   HorizontalTextAlignment="Center"/>

            <Border BackgroundColor="#1E1E1E" Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="12">

                    <!-- Primeira linha de Filtros: Datas -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Data Inicial" TextColor="#AAAAAA" FontSize="12" FontAttributes="Bold"/>
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="10,0">
                                <DatePicker Date="{Binding DataInicio}" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Data Final" TextColor="#AAAAAA" FontSize="12" FontAttributes="Bold"/>
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="10,0">
                                <DatePicker Date="{Binding DataFim}" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Segunda linha de Filtros: Tabela e Ação -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Tabela Afetada" TextColor="#AAAAAA" FontSize="12" FontAttributes="Bold"/>
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="10,0">
                                <Entry Text="{Binding Entidade}" Placeholder="Ex: Servico" PlaceholderColor="#888888" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Ação" TextColor="#AAAAAA" FontSize="12" FontAttributes="Bold"/>
                            <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="10,0">
                                <!-- DICA: Na sua ViewModel, crie uma ListaTiposAcao com os enums para o ItemsSource -->
                                <Picker ItemsSource="{Binding ListaAcoes}"
                                            SelectedItem="{Binding AcaoSelecionada}" 
                                            TitleColor="#888888" 
                                            TextColor="White" 
                                            BackgroundColor="Transparent" 
                                            VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Terceira linha: Usuário -->
                    <!--<VerticalStackLayout Spacing="5">
                        <Label Text="Responsável pela ação" TextColor="#AAAAAA" FontSize="12" FontAttributes="Bold"/>
                        <Border BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="10,0">
                            <Entry Text="{Binding UsuarioLog}" Placeholder="Ex: João" PlaceholderColor="#888888" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>-->

                    <!-- Botão Pesquisar -->
                    <Button Text="Pesquisar" 
                            Command="{Binding ConsultarLogCommand}"
                            Style="{StaticResource BotaoCinzaStyle}"
                            Margin="0,5,0,0"/>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- LISTA DE RESULTADOS (Linha 1) -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding ListaLog}" SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1E1E1E" Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                      Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirTelaDetalhesCommand}"
                                      CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="8">

                            <!-- Cabeçalho do Card: Data e Ação -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                <!-- FORMATO DA DATA: dd/MM/yyyy HH:mm -->
                                <HorizontalStackLayout>
                                <Label Text="Data da Ação:" Margin="0,3,0,0" FontAttributes="Bold"/>
                                <Label Grid.Column="0" Text="{Binding Data_Hora_Acao, StringFormat='{0:dd/MM/yyyy HH:mm}'}" TextColor="#AAAAAA" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" Margin="   5,0,0,0"/>
                                </HorizontalStackLayout>

                                <Border Grid.Column="1" BackgroundColor="#2A2A2A" StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="8,4">
                                    <Label Text="{Binding Tipo_Acao}" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold"/>
                                </Border>
                            </Grid>

                            <!-- Informações Principais -->
                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Tabela:" TextColor="Gray" FontSize="14" FontAttributes="Bold"/>
                                    <Label Text="{Binding Entidade_Afetada}" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Registro ID:" TextColor="Gray" FontSize="13"/>
                                    <Label Text="{Binding Registro_ID}" TextColor="White" FontSize="13"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Tela Vazia -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="10" Margin="0,40,0,0">
                    <Label Text="🔍" FontSize="40" HorizontalOptions="Center"/>
                    <Label Text="Nenhum log encontrado." TextColor="#FFFFFF" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Altere os filtros de data ou tabela." TextColor="#888888" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>
    </Grid>
</ContentPage>