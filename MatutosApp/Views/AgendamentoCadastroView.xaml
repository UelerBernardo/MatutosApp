<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.AgendamentoCadastroView"
             Title="AgendamentoCadastroView">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30">

            <!-- Cabeçalho -->
            <Label Text="Escolha seu horário"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#2B0B3F"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20"/>

            <!-- Seleção do Barbeiro -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Profissional" FontSize="14" FontAttributes="Bold" TextColor="Black"/>
                <Frame BorderColor="#2B0B3F" CornerRadius="8" Padding="0" HasShadow="False" HeightRequest="50">
                    <Picker Title="Selecione o barbeiro..."
                            ItemsSource="{Binding ListaBarbeiro}"
                            ItemDisplayBinding="{Binding Nome}"
                            SelectedItem="{Binding BarbeiroSelecionado}"
                            Margin="10,0"
                            TextColor="Black"
                            TitleColor="Gray"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Seleção da Data -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Data" FontSize="14" FontAttributes="Bold" TextColor="Black"/>
                <Frame BorderColor="#2B0B3F" CornerRadius="8" Padding="0" HasShadow="False" HeightRequest="50">
                    <DatePicker Date="{Binding Data_Selecionada}"
                                MinimumDate="{Binding DataMinima}"
                                Margin="10,0"
                                TextColor="Black"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Seleção da Hora -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Horário" FontSize="14" FontAttributes="Bold" TextColor="Black"/>
                <Frame BorderColor="#2B0B3F" CornerRadius="8" Padding="0" HasShadow="False" HeightRequest="50">
                    <TimePicker Time="{Binding Hora_Selecionada}"
                                Margin="10,0"
                                TextColor="Black"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Botão de Avançar -->
            <Button Text="AVANÇAR PARA SERVIÇOS"
                    Command="{Binding CadastrarCommand}"
                    BackgroundColor="#2B0B3F"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="55"
                    Margin="0, 30, 0, 0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>