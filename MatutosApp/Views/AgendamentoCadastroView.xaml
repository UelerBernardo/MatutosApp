<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.AgendamentoCadastroView"
             BackgroundColor="#152A38"
             Title=""
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Spacing="30" Padding="20,40,20,40">

            <Label Text="Appointment"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="White"
                   FontFamily="Cursive" 
                   HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="15">
                <Label Text="Select Barber" FontSize="18" FontAttributes="Bold" TextColor="White"/>

                <CollectionView ItemsSource="{Binding ListaBarbeiro}"
                                SelectedItem="{Binding BarbeiroSelecionado}"
                                SelectionMode="Single"
                                HeightRequest="120">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="15"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="45, *" ColumnSpacing="10">
                                <Border Grid.Column="0" BackgroundColor="#FE6D8E" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Image Source="icon_user_white.png" Margin="8" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Nome}" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="★★★★☆" TextColor="White" FontSize="10" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Border BackgroundColor="#D9EFFF" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="25">

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Choose the date" FontSize="16" FontAttributes="Bold" TextColor="#152A38"/>

                        <CollectionView ItemsSource="{Binding ListaDatas}" 
                                        SelectedItem="{Binding Data_Selecionada}" 
                                        SelectionMode="Single"
                                        HeightRequest="75">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="60" Padding="5">
                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                            <Label Text="{Binding DiaSemana}" FontSize="12" TextColor="#666666" HorizontalOptions="Center"/>
                                            <Label Text="{Binding DiaMes}" FontSize="18" FontAttributes="Bold" TextColor="#152A38" HorizontalOptions="Center"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#D9EFFF" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Choose the time" FontSize="16" FontAttributes="Bold" TextColor="#152A38"/>

                    <CollectionView ItemsSource="{Binding ListaHorarios}" 
                                    SelectedItem="{Binding Hora_Selecionada}" 
                                    SelectionMode="Single"
                                    HeightRequest="90">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,8">
                                    <Label Text="{Binding HoraFormatada}" FontSize="12" FontAttributes="Bold" TextColor="#152A38" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Button Text="Book Appointment"
                    Command="{Binding CadastrarCommand}"
                    BackgroundColor="#FE6D8E"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="55"
                    Margin="0, 10, 0, 0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>