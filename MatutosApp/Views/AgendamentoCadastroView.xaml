<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.AgendamentoCadastroView"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Spacing="30" Padding="20,40,20,40">

            <Label Text="Agendamento"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   FontFamily="Cursive" 
                   HorizontalOptions="Center" />

            <!-- BLOCO 1: BARBEIROS -->
            <VerticalStackLayout Spacing="15">
                <Label Text="Selecione o Barbeiro" FontSize="18" FontAttributes="Bold" TextColor="#CCCCCC"/>

                <CollectionView ItemsSource="{Binding ListaBarbeiro}"
                                SelectedItem="{Binding BarbeiroSelecionado}"
                                SelectionMode="Single"
                                HeightRequest="120">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="15"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <!-- Adicionado o VSM na Grid que engloba o Barbeiro. 
                                 A borda será desenhada em volta do nome e foto inteiros. -->
                            <Border BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 8" Padding="5">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="StrokeThickness" Value="0" />
                                                <Setter Property="Stroke" Value="Transparent" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="StrokeThickness" Value="2" />
                                                <Setter Property="Stroke" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="45, *" ColumnSpacing="10">
                                    <Border Grid.Column="0" BackgroundColor="#2A2A2A" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <Image Source="{Binding UrlImagemCompleta}" Margin="1" HeightRequest="50"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Nome}" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="★★★★☆" TextColor="#888888" FontSize="10" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- BLOCO 2: DATAS -->
            <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="25">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Escolha o Dia:" FontSize="16" FontAttributes="Bold" TextColor="#CCCCCC"/>

                        <CollectionView ItemsSource="{Binding ListaDatas}" 
                                        SelectedItem="{Binding Data_Selecionada}" 
                                        SelectionMode="Single"
                                        HeightRequest="75">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>

                                    <!-- Adicionado o VSM na Borda do Dia -->
                                    <Border BackgroundColor="#2A2A2A" StrokeShape="RoundRectangle 12" WidthRequest="60" Padding="5">

                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="StrokeThickness" Value="0" />
                                                        <Setter Property="Stroke" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="StrokeThickness" Value="2" />
                                                        <Setter Property="Stroke" Value="#FFFFFF" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>

                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                            <Label Text="{Binding DiaSemana}" FontSize="12" TextColor="#AAAAAA" HorizontalOptions="Center"/>
                                            <Label Text="{Binding DiaMes}" FontSize="18" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center"/>
                                        </VerticalStackLayout>
                                    </Border>

                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- BLOCO 3: HORÁRIOS -->
            <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Horário do Serviço:" FontSize="16" FontAttributes="Bold" TextColor="#CCCCCC"/>

                    <CollectionView ItemsSource="{Binding ListaHorarios}" 
                                    SelectedItem="{Binding Hora_Selecionada}" 
                                    SelectionMode="Single"
                                    HeightRequest="90">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <!-- Adicionado o VSM na Borda do Horário -->
                                <Border BackgroundColor="#2A2A2A" StrokeShape="RoundRectangle 8" Padding="10,8">

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="StrokeThickness" Value="0" />
                                                    <Setter Property="Stroke" Value="Transparent" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="StrokeThickness" Value="2" />
                                                    <Setter Property="Stroke" Value="#FFFFFF" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <Label Text="{Binding HoraFormatada}" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Button Text="Vincular Serviço"
                    Command="{Binding CadastrarCommand}"
                    Style="{StaticResource BotaoVincularStyle}"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="55"
                    Margin="0, 10, 0, 0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>