<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.AgendamentoServicoView"
             BackgroundColor="#121212"
             Title=""
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Estilo para o botão de Diminuir (-) -->
        <Style x:Key="BotaoDiminuirStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#2A2A2A" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <!-- Clareia levemente ao clicar -->
                                <Setter Property="BackgroundColor" Value="#444444" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="BotaoVermelhoStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#a15650" />
            <Setter Property="BorderColor" Value="#a15650" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="HeightRequest" Value="45" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#a15650" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <!-- Estilo para os botões Aumentar (+) e Finalizar -->
        <Style x:Key="BotaoCinzaStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E0E0E0" />
            <Setter Property="TextColor" Value="#121212" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <!-- Fica cinza escuro e inverte a letra para branco ao clicar -->
                                <Setter Property="BackgroundColor" Value="#888888" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- Estilo para o botão Cancelar (Contorno) -->
        <Style x:Key="BotaoCancelarStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#AAAAAA" />
            <Setter Property="BorderColor" Value="#333333" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <!-- Preenche o fundo levemente e acende o texto ao clicar -->
                                <Setter Property="BackgroundColor" Value="#1E1E1E" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="5" HorizontalOptions="Center" Margin="0,20,0,10">
            <Image Source="tesourapente.png" HeightRequest="100"/>
            <Label Text="O que vamos fazer?" FontSize="24" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
            <Label Text="Selecione os serviços desejados" FontSize="14" TextColor="#AAAAAA" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <Border Grid.Row="1" 
                BackgroundColor="#1E1E1E" 
                Stroke="#333333" 
                StrokeThickness="1" 
                StrokeShape="RoundRectangle 12" 
                Margin="20,0,20,15" 
                HeightRequest="50"
                Padding="5,0">

            <SearchBar Placeholder="Buscar serviço..." 
                       PlaceholderColor="#888888" 
                       TextColor="#FFFFFF" 
                       CancelButtonColor="#FFFFFF"
                       Text="{Binding TextoBusca}" />
        </Border>

        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding ListaServico}" 
                        SelectionMode="None"
                        Margin="20,0,20,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="20" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 16" Margin="0,0,0,15" Padding="15">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">

                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding ServicoOriginal.Descricao}" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                <Label Text="{Binding ServicoOriginal.Preco, StringFormat='R$ {0:F2}'}" FontSize="15" TextColor="#E0E0E0" FontAttributes="Bold"/>
                                <HorizontalStackLayout>
                                    <Image Source="relogioagendar.png" HeightRequest="15" WidthRequest="15" Margin="0,0,5,0"/>
                                    <Label Text="{Binding ServicoOriginal.Duracao}" FontSize="12" TextColor="#888888"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                                <!-- Aplicado o BotaoDiminuirStyle -->
                                <Button Text="-" Command="{Binding DiminuirCommand}" Style="{StaticResource BotaoDiminuirStyle}" WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0" FontAttributes="Bold" FontSize="18"/>

                                <Label Text="{Binding QuantidadeSelecionada}" FontSize="18" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" MinimumWidthRequest="20" HorizontalTextAlignment="Center"/>

                                <!-- Aplicado o BotaoCinzaStyle -->
                                <Button Text="+" Command="{Binding AumentarCommand}" Style="{StaticResource BotaoCinzaStyle}" WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0" FontAttributes="Bold" FontSize="18"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="0">
            <BoxView HeightRequest="1" Color="#333333" />
            <VerticalStackLayout Spacing="15" Padding="20,10,20,20" BackgroundColor="#121212">
                <!-- Aplicado o BotaoCinzaStyle -->
                <Button Text="Finalizar" Command="{Binding CadastrarCommand}" Style="{StaticResource BotaoCinzaStyle}" FontAttributes="Bold" FontSize="16" CornerRadius="12"  />

                <!-- Aplicado o BotaoCancelarStyle -->
                <Button Text="Cancelar" Command="{Binding CancelarAgendamentoCommand}" Style="{StaticResource BotaoVermelhoStyle}" FontAttributes="Bold" FontSize="16" CornerRadius="12"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

    </Grid>
</ContentPage>