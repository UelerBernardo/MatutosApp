<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MatutosApp.Views.AgendamentoDetalhesView"
             Title="AgendamentoDetalhesView">
    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="15">

            <Border BackgroundColor="White" Padding="15" StrokeShape="RoundRectangle 10">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding DadosDoAgendamento.Codigo_Agendamento, StringFormat='Pedido Nº {0}'}" 
                           FontAttributes="Bold" FontSize="18" TextColor="#2B0B3F"/>

                    <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📅 Início:" FontAttributes="Bold" TextColor="#666"/>
                        <Label Text="{Binding DadosDoAgendamento.Data_Agendamento, StringFormat='{0:dd/MM/yyyy HH:mm}'}" TextColor="#333"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="⏰ Fim (Previsto):" FontAttributes="Bold" TextColor="#666"/>
                        <Label Text="{Binding DadosDoAgendamento.Data_Fim_Agendamento, StringFormat='{0:HH:mm}'}" TextColor="#333"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Padding="15" StrokeShape="RoundRectangle 10">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="5">
                    <Label Text="👤 Cliente:" FontAttributes="Bold" TextColor="#666"/>
                    <Label Text="{Binding DadosDoAgendamento.Cliente.Nome}" TextColor="#333" FontSize="16" Margin="0,0,0,10"/>

                    <Label Text="✂️ Barbeiro:" FontAttributes="Bold" TextColor="#666"/>
                    <Label Text="{Binding DadosDoAgendamento.Barbeiro.Nome}" TextColor="#333" FontSize="16"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Padding="15" StrokeShape="RoundRectangle 10">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Serviços Realizados" FontAttributes="Bold" FontSize="16" TextColor="#2B0B3F"/>

                    <CollectionView ItemsSource="{Binding DadosDoAgendamento.Agendamento_Servicos}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="50, *, 80" Padding="0,5">
                                    <Label Grid.Column="0" Text="{Binding Quantidade_Servico, StringFormat='{0}x'}" 
                                           VerticalOptions="Center" TextColor="#666" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding Servico.Nome}" 
                                           VerticalOptions="Center" TextColor="#333"/>
                                    <Label Grid.Column="2" Text="{Binding Valor_Total_Item, StringFormat='R$ {0:F2}'}" 
                                           HorizontalOptions="End" VerticalOptions="Center" FontAttributes="Bold" TextColor="#2B0B3F"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#2B0B3F" Padding="20" StrokeShape="RoundRectangle 10">
                <Border.Shadow>
                    <Shadow Brush="#2B0B3F" Offset="0,4" Radius="8" Opacity="0.3" />
                </Border.Shadow>
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="VALOR TOTAL" FontAttributes="Bold" FontSize="16" TextColor="White" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding DadosDoAgendamento.Valor_Total_Agendamento, StringFormat='R$ {0:F2}'}" 
                           FontAttributes="Bold" FontSize="22" TextColor="White" VerticalOptions="Center"/>
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="10" Margin="0,15,0,30">
                <Button Text="VOLTAR AO INÍCIO" 
                        Command="{Binding VoltarCommand}"
                        BackgroundColor="Transparent"
                        BorderColor="#2B0B3F"
                        BorderWidth="2"
                        TextColor="#2B0B3F"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50"/>

                <Button Text="Cancelar Agendamento" 
                        Command="{Binding CancelarAgendamentoCommand}"
                        BackgroundColor="Transparent"
                        TextColor="Red"
                        FontAttributes="Bold"
                        HeightRequest="40"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>